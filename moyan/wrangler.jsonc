{
  "name": "moyan",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker.mjs",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moyan-sync",
      "database_id": "13ca7a6e-f1b8-4544-8acf-514860d67a29"
    }
  ]
}
